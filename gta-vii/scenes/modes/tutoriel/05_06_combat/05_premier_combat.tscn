[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/modes/tutoriel/commun/briefing_compact.gd" id="briefing_compact"]

[ext_resource type="Theme" path="res://scenes/interfaces/theme_intervention/theme.tres" id="intervention"]

[ext_resource type="PackedScene" path="res://scenes/jeu/main.tscn" id="main"]
[ext_resource type="Script" path="res://scenes/modes/tutoriel/05_06_combat/salle_combat.gd" id="salle"]
[ext_resource type="Script" path="res://scenes/modes/tutoriel/05_06_combat/decor_premier_combat.gd" id="decor"]
[ext_resource type="Script" path="res://scenes/modes/tutoriel/05_06_combat/progression_combat.gd" id="progression"]

[node name="TutorielCombat" instance=ExtResource("main")]
script = ExtResource("salle")
session_tutoriel = true

[node name="SalleFixe" type="Node3D" parent="."]
script = ExtResource("decor")

[node name="ProgressionCombat" type="Node" parent="."]
script = ExtResource("progression")

[node name="Briefing" type="CanvasLayer" parent="."]

[node name="Panneau" type="PanelContainer" parent="Briefing"]
script = ExtResource("briefing_compact")
offset_left = 400.0
offset_top = 24.0
offset_right = 1100.0
offset_bottom = 150.0
mouse_filter = 2
theme = ExtResource("intervention")

[node name="Disposition" type="VBoxContainer" parent="Briefing/Panneau"]
layout_mode = 2
mouse_filter = 2

[node name="Titre" type="Label" parent="Briefing/Panneau/Disposition"]
theme_type_variation = &"TitreIntervention"
layout_mode = 2
text = "05 · PREMIÈRE CRÉATURE"
theme_override_font_sizes/font_size = 20
mouse_filter = 2

[node name="Consigne" type="Label" parent="Briefing/Panneau/Disposition"]
layout_mode = 2
autowrap_mode = 2
mouse_filter = 2

[node name="Rappel" type="Label" parent="Briefing/Panneau/Disposition"]
theme_type_variation = &"NoteIntervention"
layout_mode = 2
autowrap_mode = 2
mouse_filter = 2
