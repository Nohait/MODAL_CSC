[ext_resource type="Script" path="res://scenes/modes/tutoriel/00_03_parvis/etapes/etape_tutoriel.gd" id="1"]

[resource]
script = ExtResource("1")
titre = "01 · PRENDRE LE FEU DE VITESSE"
consigne = "Visez les deux petits foyers et maintenez le clic gauche pour les éteindre."
repliques = PackedStringArray("Ces deux petits foyers sont à ta portée. Vise la base des flammes avec ton extincteur. Approche-toi si le jet n’arrive pas jusqu’à elles.", "Là-haut, la mousse servira aussi à te défendre. Mais certaines choses résistent bien mieux que ces flammes…")
objectif = 1
