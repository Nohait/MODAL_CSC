[ext_resource type="Script" path="res://scenes/modes/tutoriel/00_03_parvis/etapes/etape_tutoriel.gd" id="1"]

[resource]
script = ExtResource("1")
titre = "PREMIÈRE INTERVENTION"
consigne = "Prenez vos marques et parlez au chef."
repliques = PackedStringArray("Respire. On entre ensemble. Reste près de moi. Prends le temps de regarder autour de toi.", "Il reste des victimes là-haut. Et l’équipe a vu des choses bouger dans les flammes… On éclaircira ça à l’intérieur.", "Avant de franchir cette porte, on vérifie ton extincteur. Je préfère te voir faire ici que devoir te le rappeler au troisième étage.")
objectif = 0
