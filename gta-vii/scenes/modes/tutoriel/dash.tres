[ext_resource type="Script" path="res://scenes/modes/tutoriel/etape_tutoriel.gd" id="1"]

[resource]
script = ExtResource("1")
titre = "03 · UNE ISSUE, TOUJOURS"
consigne = "Terminez un dash dans le repère ambré près de l’entrée · Espace + déplacement."
repliques = PackedStringArray("S’il faut dégager le passage, garde une issue. Déplace-toi puis appuie sur Espace pour faire un dash jusqu’au repère ambré.", "Tu verras bientôt pourquoi rester immobile devant une créature est une très mauvaise idée. Et on a de quoi frapper plus fort qu’un extincteur, quand ce sera nécessaire.")
objectif = 3
