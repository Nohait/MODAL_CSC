[ext_resource type="Script" path="res://scenes/modes/tutoriel/etape_tutoriel.gd" id="1"]

[resource]
script = ExtResource("1")
titre = "02 · GARDER DU SOUFFLE"
consigne = "Utilisez le jet jusqu’à entamer la réserve, puis relâchez pour la recharger."
repliques = PackedStringArray("Regarde ta réserve de mousse en haut à gauche. Un jet continu la vide vite. Essaie, puis relâche : elle se reconstitue toute seule.", "Le bon réflexe, c’est de garder de quoi réagir. On pourra améliorer ton matériel après une salle, selon les personnes que tu ramèneras.")
objectif = 2
