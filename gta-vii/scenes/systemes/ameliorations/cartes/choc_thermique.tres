[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/choc_thermique.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"choc_thermique"
titre = "Choc thermique"
description = "Les ennemis refroidis explosent à leur mort et blessent les ennemis proches."
pictogramme = ExtResource("icone")
modes = 3
effet = "choc_thermique"
obtention_unique = true
puissance_variable = false
rarete = "legendaire"
valeur = 25.0
texte_effet = "Explosion : %s dégâts"
prerequis = Array[StringName]([&"jet_givre"])
