[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/dash.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"jet_mobile"
titre = "Danse avec les flammes"
description = "Le jet gagne en puissance lorsque vous courez."
pictogramme = ExtResource("icone")
modes = 2
effet = "jet_mobile"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 25.0
texte_effet = "+{valeur} % dégâts en mouvement"
