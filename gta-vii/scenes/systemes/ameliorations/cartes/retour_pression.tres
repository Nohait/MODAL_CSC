[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/retour_pression.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"retour_pression"
titre = "Retour de pression"
description = "Un bouclier brisé repousse les ennemis."
pictogramme = ExtResource("icone")
modes = 3
effet = "retour_pression"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 5.0
texte_effet = "Repousse les ennemis proches"
prerequis = Array[StringName]([&"mousse_protectrice"])
