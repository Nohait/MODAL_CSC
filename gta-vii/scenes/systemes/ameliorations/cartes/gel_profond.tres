[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/gel_profond.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"gel_profond"
titre = "Gel profond"
description = "Un jet prolongé immobilise brièvement les ennemis."
pictogramme = ExtResource("icone")
modes = 3
effet = "gel_profond"
obtention_unique = true
puissance_variable = false
rarete = "epique"
valeur = 0.6
texte_effet = "Immobilisation : %s s"
prerequis = Array[StringName]([&"jet_givre"])
