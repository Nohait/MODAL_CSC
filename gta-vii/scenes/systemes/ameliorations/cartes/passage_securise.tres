[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/passage_securise.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"passage_securise"
titre = "Passage sécurisé"
description = "La mousse protège les victimes qui la traversent."
pictogramme = ExtResource("icone")
modes = 3
effet = "passage_securise"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 10.0
texte_effet = "Bouclier : %s PV"
prerequis = Array[StringName]([&"mousse_persistante"])
