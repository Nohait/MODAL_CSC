[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/maintenance_preventive.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"maintenance_preventive"
titre = "Maintenance préventive"
description = "Un équipement usé est rechargé après chaque vague."
pictogramme = ExtResource("icone")
modes = 2
effet = "maintenance_preventive"
obtention_unique = true
puissance_variable = false
rarete = "epique"
valeur = 1.0
texte_effet = "Une recharge offerte / vague"
prerequis = Array[StringName]([])
