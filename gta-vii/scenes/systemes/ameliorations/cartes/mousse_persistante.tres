[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/mousse_persistante.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"mousse_persistante"
titre = "Mousse persistante"
description = "Le jet laisse une mousse qui blesse les ennemis."
pictogramme = ExtResource("icone")
modes = 3
effet = "mousse_persistante"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 8.0
texte_effet = "%s dégâts / s"
prerequis = Array[StringName]([])
