[gd_resource type="Resource" script_class="Amelioration" format=3]

[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/dernier_souffle.svg" id="icone"]

[resource]
script = ExtResource("script")
identifiant = &"dernier_souffle"
titre = "Dernier souffle"
description = "Augmente les dégâts à 25 % de vie ou moins."
pictogramme = ExtResource("icone")
modes = 3
type_bonus = "permanent"
effet = "dernier_souffle"
valeur = 40.0
duree = 0
texte_effet = "+%s %% de dégâts en danger"
