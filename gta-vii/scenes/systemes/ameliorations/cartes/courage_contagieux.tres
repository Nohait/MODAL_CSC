[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/courage_contagieux.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"courage_contagieux"
titre = "Courage contagieux"
description = "Un sauvetage accélère brièvement votre équipe."
pictogramme = ExtResource("icone")
modes = 3
effet = "courage_contagieux"
obtention_unique = true
puissance_variable = false
rarete = "commun"
valeur = 20.0
texte_effet = "+%s %% de vitesse pendant 3 s"
prerequis = Array[StringName]([])
