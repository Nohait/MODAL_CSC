[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/priorite_blesses.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"point_suture"
titre = "Point de suture"
description = "En libérant une victime, vous lui rendez une partie de la vie qu’elle a perdue."
pictogramme = ExtResource("icone")
modes = 1
effet = "point_suture"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 35.0
texte_effet = "%s %% des PV manquants"
prerequis = Array[StringName]([])

