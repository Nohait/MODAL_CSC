[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/zone_repli.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"zone_repli"
titre = "Zone de repli"
description = "Un bouclier du camion brisé crée un abri temporaire."
pictogramme = ExtResource("icone")
modes = 2
effet = "zone_repli"
obtention_unique = true
puissance_variable = false
rarete = "rare"
valeur = 30.0
texte_effet = "−%s %% de dégâts pendant 3 s"
prerequis = Array[StringName]([&"bouclier_camion"])
