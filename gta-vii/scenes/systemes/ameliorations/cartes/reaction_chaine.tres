[gd_resource type="Resource" script_class="Amelioration" format=3]
[ext_resource type="Script" path="res://scenes/systemes/ameliorations/amelioration.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/textures/interfaces/ameliorations/pictogrammes/reaction_chaine.svg" id="icone"]
[resource]
script = ExtResource("script")
identifiant = &"reaction_chaine"
titre = "Réaction en chaîne"
description = "Les ennemis enrobés projettent de la mousse à leur mort."
pictogramme = ExtResource("icone")
modes = 3
effet = "reaction_chaine"
obtention_unique = true
puissance_variable = false
rarete = "legendaire"
valeur = 3.0
texte_effet = "Propagation : %s m"
prerequis = Array[StringName]([&"enrobage"])
