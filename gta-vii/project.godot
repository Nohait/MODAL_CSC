; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GTA VII"
run/main_scene="res://scenes/interfaces/menus/ecran_titre.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SonsInterface="*res://scenes/systemes/audio/sons_interface.gd"
CatalogueEnnemis="*res://scenes/systemes/ennemis/catalogue_ennemis.gd"
SuccesManager="*res://scenes/systemes/succes/succes_manager.gd"
CursorManager="*res://cursor_manager.gd"
Reglages="*res://scenes/systemes/reglages/reglages.gd"
StatistiquesZombie="*res://scenes/modes/zombie/statistiques/statistiques_zombie.gd"
SauvegardeZombie="*res://scenes/modes/zombie/sauvegarde/sauvegarde_zombie.gd"
SauvegardeClassique="*res://scenes/jeu/sauvegarde/sauvegarde_classique.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/textures/interfaces/curseurs/curseur_lance.svg"
mouse_cursor/custom_image_hotspot=Vector2(3, 3)

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://docs/": "green",
"res://scenes/": "red"
}

[global_group]

enemies=""
flaque=""
projectile=""
collider=""
victime=""
fleche=""
mobiles=""

